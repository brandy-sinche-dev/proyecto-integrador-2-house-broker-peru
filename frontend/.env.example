# Copia este archivo a ".env" o ".env.local" y ajusta los valores según tu entorno.
# El frontend se ejecuta contra un backend Django + DRF por defecto.
#
# Cambia a "true" para simular la API en el navegador (mocks axios)
# sin necesidad de levantar el backend.
VITE_ENABLE_MOCKS=false

# URL base de la API
VITE_API_URL=http://localhost:8000/api

# Concierge IA - Google Gemini API Key (EPIC-AI)
# Obtenla en: https://aistudio.google.com/
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.5-flash-lite
