# Copia este archivo a ".env" y ajusta los valores según tu entorno.
# El frontend se ejecuta contra un backend Django + DRF por defecto.
#
# Cambia a "true" para simular la API en el navegador (mocks axios)
# sin necesidad de levantar el backend.
VITE_ENABLE_MOCKS=false

# URL base de la API (fase provisoria; la API se candida regular en la
# fase de autenticación y tu asignación API Gateway posterior).
VITE_API_URL=http://localhost:8000/api